DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/datasys?schema=public"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_NAME="Administrateur DATASYS"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
# Use a Gmail app password, not your regular Gmail password.
GMAIL_USER="admin@example.com"
GMAIL_APP_PASSWORD="replace-with-a-gmail-app-password"
# Comma-separated verified Gmail send-as aliases; GMAIL_USER is allowed automatically.
GMAIL_ALLOWED_FROM="support@example.com"
